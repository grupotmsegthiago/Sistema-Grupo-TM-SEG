{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/atualizar-dev.cjs",
        "matcher": "Write|StrReplace|Delete",
        "timeout": 60,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/fieldset-scroll.cjs",
        "matcher": "Write|StrReplace",
        "timeout": 15,
        "failClosed": false
      }
    ]
  }
}

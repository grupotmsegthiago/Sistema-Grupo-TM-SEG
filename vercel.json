{
  "installCommand": "npm install --no-audit --no-fund --legacy-peer-deps",
  "buildCommand": "vite build && node build-server.mjs",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sistema-grupo-tm-seg.vercel.app"
        }
      ],
      "destination": "https://sistema.grupotmseg.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/minute",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/nf-retry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/email-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/dhl",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/zapi",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

{
  "installCommand": "npm install --no-audit --no-fund --legacy-peer-deps",
  "buildCommand": "vite build && node build-server.mjs",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    },
    "api/whatsapp/webhook/inbound.ts": {
      "maxDuration": 300
    },
    "api/geocode-address.ts": {
      "maxDuration": 60
    },
    "api/reverse-geocode.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/whatsapp/webhook/inbound",
      "destination": "/api/whatsapp/webhook/inbound"
    },
    {
      "source": "/api/geocode-address",
      "destination": "/api/geocode-address"
    },
    {
      "source": "/api/reverse-geocode",
      "destination": "/api/reverse-geocode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/minute",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/nf-retry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/email-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/dhl",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/zapi",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

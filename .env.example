# ── Supabase (frontend) ──
# Projeto oficial: ajhmmjuewdsukecaimik.supabase.co
# Se a Vercel importou outro projeto (integracao Supabase), remova ou corrija estas vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (servidor — NÃO commitar valores reais) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel Cron + Webhooks ──
# Gere um segredo forte (ex: openssl rand -hex 32)
CRON_SECRET=
# Mesmo valor no header x-webhook-secret do webhook Supabase (INSERT missions)
SUPABASE_WEBHOOK_SECRET=

# ── Push notifications ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── E-mail ──
RESEND_API_KEY=

# ── Custos IA / Cursor ──
# Espelho real do dashboard (recomendado):
# 1) Abra https://cursor.com/dashboard → F12 → Application → Cookies → cursor.com
# 2) Copie o valor de WorkosCursorSessionToken
CURSOR_SESSION_TOKEN=
# Opcional: faturas Stripe (se tiver acesso merchant)
STRIPE_SECRET_KEY=
STRIPE_CURSOR_CUSTOMER_ID=
# Plano base para conversão BRL (ajuste ao seu plano real)
CURSOR_PLAN_NAME=Cursor Ultra
CURSOR_PLAN_MONTHLY_USD=200
# CURSOR_PLAN_MONTHLY_BRL=120
BILLING_USD_RATE=5.50
BILLING_IOF_PCT=4.38
OPERATIONAL_SAVINGS_BRL=715

# ── Z-API (WhatsApp) ──
# Instância mobile (recomendado — Central Torres / Business no eSIM)
ZAPI_MOBILE_ID=
ZAPI_MOBILE_TOKEN=
ZAPI_MOBILE_INSTANCIA=Central Torres
# Legado (fallback se ZAPI_MOBILE_* vazio)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_INSTANCE_TYPE=mobile
ZAPI_OFFICIAL_PHONE=11926839456

# ── URL pública do sistema (links em e-mail, WhatsApp, DHL) ──
APP_PUBLIC_URL=https://sistema.grupotmseg.com.br
SYSTEM_URL=https://sistema.grupotmseg.com.br

# ── Google Gemini (IA) ──
# Use GEMINI_API_KEY na Vercel (servidor lê também AI_INTEGRATIONS_GEMINI_API_KEY)
GEMINI_API_KEY=

# Asaas (TM GESTÃO / TM SEGURANÇA / TM SECURITY)
# TM Gestão — preferir ASAAS_TMGESTAO_API na Vercel (legado: ASAAS_API_KEY)
ASAAS_TMGESTAO_API=
ASAAS_API_KEY=
# TM Segurança (Consultoria) — preferir TMSEGURANCA / ASAAS_TMSEGURANCA_API
TMSEGURANCA=
ASAAS_TMSEGURANCA_API=
# Legado (ainda aceito se TMSEGURANCA estiver vazio)
ASAAS_API_KEY_TMSECURITY=
ASAAS_API_KEY_TMSECURITY_60=
# WalletId da conta financeiro central (repasse interno entre contas Asaas vinculadas)
ASAAS_FINANCEIRO_WALLET_ID=6641fec4-8476-48e3-90a8-3db6b14f538c
# Token do webhook de aprovação de transferências Asaas (header asaas-access-token)
# TM SEGURANÇA — CNPJ 28.804.378/0001-67
ASAAS_TRANSFER_WEBHOOK_TOKEN=
# true = tenta Pix antes do repasse interno; false = interno primeiro (padrão)
ASAAS_TRANSFER_PIX_FIRST=false
# true = não tenta repasse interno (útil se contas Asaas não estão vinculadas)
ASAAS_SKIP_INTERNAL_TRANSFER=false
# PLUGNOTAS_API_KEY=

# ── Supabase (frontend) ──
# Projeto oficial: ajhmmjuewdsukecaimik.supabase.co
# Se a Vercel importou outro projeto (integracao Supabase), remova ou corrija estas vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (servidor — NÃO commitar valores reais) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel Cron + Webhooks ──
# Gere um segredo forte (ex: openssl rand -hex 32)
CRON_SECRET=
# Mesmo valor no header x-webhook-secret do webhook Supabase (INSERT missions)
SUPABASE_WEBHOOK_SECRET=

# ── Push notifications ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── E-mail ──
RESEND_API_KEY=

# ── Z-API (WhatsApp) ──
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ── URL pública do sistema (links em e-mail, WhatsApp, DHL) ──
APP_PUBLIC_URL=https://sistema.grupotmseg.com.br
SYSTEM_URL=https://sistema.grupotmseg.com.br

# ── Google Gemini (IA) ──
# Use GEMINI_API_KEY na Vercel (servidor lê também AI_INTEGRATIONS_GEMINI_API_KEY)
GEMINI_API_KEY=

